{
  "name": "ghana-health-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 50",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:index-embeddings": "node --import tsx scripts/index-abena-embeddings.ts",
    "eval:live-pipeline": "node --import tsx scripts/eval-live-pipeline.ts",
    "eval:live-stream": "EVAL_STREAM=1 node --import tsx scripts/eval-live-pipeline.ts",
    "eval:understanding": "node --import tsx scripts/eval-understanding.ts",
    "eval:understanding:fallback": "node --import tsx scripts/eval-understanding-fallback.ts",
    "eval:conversation:fallback": "node --import tsx scripts/eval-conversation-fallback-contract.ts",
    "eval:language-response": "node --import tsx scripts/eval-language-response-contract.ts",
    "eval:health-plan": "node --import tsx scripts/eval-health-plan.ts",
    "eval:commerce-plan": "node --import tsx scripts/eval-commerce-plan.ts",
    "eval:commerce-execute": "node --import tsx scripts/eval-commerce-execute.ts",
    "eval:commerce-confirm": "node --import tsx scripts/eval-commerce-confirm-contract.ts",
    "eval:voice-stream": "node --import tsx scripts/eval-voice-stream-contract.ts",
    "eval:voice-preview": "node --import tsx scripts/eval-voice-preview-contract.ts",
    "eval:voice-feedback": "node --import tsx scripts/eval-voice-feedback-contract.ts",
    "eval:tts-routing": "node --import tsx scripts/eval-tts-routing.ts",
    "eval:synthetic-voice-notes": "node --import tsx scripts/eval-synthetic-voice-notes.ts",
    "eval:medical:twi": "node --import tsx scripts/eval-medical-twi-response-corpus.ts",
    "eval:product-readiness": "node --import tsx scripts/eval-product-readiness.ts",
    "eval:product-readiness:prod": "EVAL_BASE_URL=https://ghanahealth.serendepify.com node --import tsx scripts/eval-product-readiness.ts",
    "eval:prod:smoke": "node --import tsx scripts/eval-production-smoke.ts",
    "eval:asr-routing": "node --import tsx scripts/eval-asr-routing.ts",
    "eval:asr-manifest": "node --import tsx scripts/validate-asr-eval-manifest.ts",
    "eval:asr-manifest:strict": "node --import tsx scripts/validate-asr-eval-manifest.ts --strict",
    "eval:local-asr-import": "node --import tsx scripts/validate-local-asr-import.ts",
    "eval:asr-feedback:export": "node --import tsx scripts/export-asr-feedback.ts",
    "eval:asr-feedback:export-contract": "node --import tsx scripts/eval-asr-feedback-export-contract.ts",
    "eval:asr-promotion": "node --import tsx scripts/audit-asr-promotion.ts",
    "eval:asr-promotion:strict": "node --import tsx scripts/audit-asr-promotion.ts --strict",
    "eval:asr-corpus": "node --import tsx scripts/audit-asr-corpus.ts",
    "eval:asr-corpus:strict": "node --import tsx scripts/audit-asr-corpus.ts --strict",
    "eval:asr-ladder": "python modal/train/benchmark_asr_ladder.py",
    "eval:asr-ladder:modal": "python modal/train/benchmark_asr_ladder.py --execute --no-wait",
    "eval:understanding:model": "modal run modal/train/benchmark_understanding.py",
    "eval:understanding:adapter": "modal run modal/train/eval_understand_adapter.py",
    "train:understanding:modal": "modal run --detach modal/train/train_understand.py --use-local-silver --max-steps 650 --push-repo teckedd/gha-understand-twi-medical-plus-language-v2",
    "push:understanding:modal": "modal run modal/train/train_understand.py --push-only --push-repo teckedd/gha-understand-twi-medical-plus-language-v2",
    "eval:understanding:model:human-aligned": "modal run modal/train/benchmark_understanding.py --model-id facebook/nllb-200-distilled-600M --adapter-id mclanorjeff/NLLB-Twi-Human-Aligned",
    "eval:understanding:llm": "node --import tsx scripts/benchmark-understanding-llm.ts",
    "eval:understanding:results": "rm -rf tmp/understanding-results && mkdir -p tmp/understanding-results && modal volume get --force ghana-health-understanding-results / tmp/understanding-results",
    "eval:understanding:score": "node --import tsx scripts/score-understanding-benchmark.ts",
    "eval:understanding:corpus-gate": "node --import tsx scripts/eval-understanding-corpus-gate.ts",
    "corpus:understanding:candidates": "node --import tsx scripts/build-understanding-corpus-candidates.ts",
    "corpus:understanding:candidates:annotate": "node --import tsx scripts/build-understanding-corpus-candidates.ts --annotate",
    "corpus:understanding:annotate": "node --import tsx scripts/annotate-understanding-corpus-candidates.ts",
    "corpus:understanding:review-sheet": "node --import tsx scripts/export-understanding-review-sheet.ts",
    "corpus:understanding:import-review-sheet": "node --import tsx scripts/import-understanding-review-sheet.ts",
    "corpus:understanding:export": "node --import tsx scripts/export-understanding-training-corpus.ts",
    "corpus:understanding:export:strict": "node --import tsx scripts/export-understanding-training-corpus.ts --strict",
    "corpus:understanding:silver": "node --import tsx scripts/export-understanding-silver-corpus.ts",
    "corpus:medical:ghana-health-symptoms": "node --import tsx scripts/import-ghana-health-symptoms.ts",
    "corpus:medical:ghana-health-symptoms:parquet": "python scripts/import_ghana_health_symptoms_parquet.py",
    "corpus:medical:qa": "node --import tsx scripts/import-medical-qa-corpus.ts",
    "corpus:medical:qa:twi": "node --import tsx scripts/translate-medical-qa-to-twi.ts",
    "research:understanding:report": "node --import tsx scripts/summarize-understanding-research.ts",
    "eval:model-card": "python modal/train/validate_model_card.py",
    "eval:hf-model-cards": "node --import tsx scripts/eval-hf-model-cards.ts",
    "train:dondo:smoke": "modal run modal/train/train_dondo_asr.py --smoke",
    "train:dondo:modal": "modal run --detach modal/train/train_dondo_asr.py --run-name dondo-waxal-twi-v1 --max-steps 800 --train-limit 1800 --eval-limit 200 --per-device-train-batch-size 1 --gradient-accumulation-steps 16 --resume-from-checkpoint auto --push-repo teckedd/gha-dondo-w2v-bert-twi-v1 --no-wait",
    "train:dondo:monitor": "node --import tsx scripts/monitor-dondo.ts",
    "train:dondo:results": "node --import tsx scripts/monitor-dondo.ts --pull --no-logs",
    "deploy:tts:stable-twi": "modal deploy modal/stable_twi_tts_service.py",
    "eval:asr-results:pull": "rm -rf tmp/asr-results && mkdir -p tmp/asr-results && modal volume get --force akan-speech-eval-results / tmp/asr-results",
    "eval:asr-results": "node --import tsx scripts/summarize-asr-results.ts",
    "deploy:understanding": "modal deploy modal/understand_service.py",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "corpus:gen": "node --import tsx scripts/gen-corpus-pack.ts",
    "corpus:synthesize-twi": "node --import tsx scripts/synthesize-twi-voice-notes.ts",
    "corpus:medical:twi": "node --import tsx scripts/build-medical-twi-response-corpus.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
