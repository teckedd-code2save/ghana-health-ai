#!/usr/bin/env bash
# Tail logs from the live ghana-health-ai-web container on the VPS.
#
# Usage:
#   bin/logs               # follow last 200 lines
#   bin/logs 500           # follow last 500 lines
#   bin/logs --since 10m   # entries from the last 10 minutes (no follow)
#   bin/logs db            # tail postgres instead of web
set -euo pipefail

VPS_HOST="${VPS_HOST:-128.140.12.62}"
VPS_USER="${VPS_USER:-root}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/optimi_github_actions}"

container="ghana-health-ai-web"
args=()

case "${1:-}" in
  db|postgres) container="ghana-health-ai-postgres"; shift ;;
esac

if [[ "${1:-}" == "--since" ]]; then
  shift
  args=(--since "${1:?--since requires a duration like 10m or 1h}")
  shift
elif [[ "${1:-}" =~ ^[0-9]+$ ]]; then
  args=(-f --tail="$1")
  shift
else
  args=(-f --tail=200)
fi

exec ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new "${VPS_USER}@${VPS_HOST}" \
  docker logs "${args[@]}" "$container"
