// Ghana Health AI — Prisma schema (MVP)
// Voice-first health companion + ecommerce for Ghana (Twi priority)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LanguageCode {
  tw
  en
  ga
  ee
  dag
}

enum IntentType {
  HEALTH
  ECOMMERCE
  GENERAL
  UNKNOWN
}

enum ConversationChannel {
  WEB
  MOBILE
  VOICE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MOMO
  USSD
  CASH
  CARD
  MOCK
}

enum SeverityFlag {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MemoryScope {
  HEALTH
  COMMERCE
  PROFILE
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  phone            String?   @unique
  email            String?   @unique
  passwordHash     String?   @map("password_hash")
  displayName      String?   @map("display_name")
  preferredLang    LanguageCode @default(tw) @map("preferred_lang")
  localeRegion     String?   @map("locale_region")
  consentVoice     Boolean   @default(false) @map("consent_voice")
  consentHealth    Boolean   @default(false) @map("consent_health")
  consentMarketing Boolean   @default(false) @map("consent_marketing")
  role             String    @default("user")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  voiceEnrollments VoiceEnrollment[]
  conversations    Conversation[]
  memories         AgentMemory[]
  asrFeedback      AsrFeedback[]
  symptomChecks    SymptomCheck[]
  carts            Cart[]
  orders           Order[]
  consentRecords   ConsentRecord[]
  emailOtps        EmailOtp[]

  @@map("users")
}

model EmailOtp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id") @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("email_otps")
}

model AgentMemory {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  sessionId      String?     @map("session_id")
  scope          MemoryScope
  key            String
  value          Json
  confidence     Float       @default(0.7)
  source         String      @default("conversation")
  lastObservedAt DateTime    @default(now()) @map("last_observed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, scope, key])
  @@index([userId, scope])
  @@index([sessionId, scope])
  @@map("agent_memories")
}

model VoiceEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  // Embedding stored as base64 float array (MVP); production: encrypted blob / vector DB
  embeddingB64    String   @map("embedding_b64") @db.Text
  passphraseHint  String?  @map("passphrase_hint")
  language        LanguageCode @default(tw)
  sampleDurationS Float?   @map("sample_duration_s")
  threshold       Float    @default(0.7)
  isActive        Boolean  @default(true) @map("is_active")
  enrolledAt      DateTime @default(now()) @map("enrolled_at")
  lastVerifiedAt  DateTime? @map("last_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("voice_enrollments")
}

model Conversation {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  channel   ConversationChannel @default(WEB)
  language  LanguageCode        @default(tw)
  title     String?
  intent    IntentType          @default(UNKNOWN)
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]
  asrFeedback AsrFeedback[]

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  language       LanguageCode?
  intent         IntentType?
  speakerLabel   String?     @map("speaker_label")
  verifiedVoice  Boolean?    @map("verified_voice")
  latencyMs      Int?        @map("latency_ms")
  disclaimer     Boolean     @default(false)
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  asrFeedback  AsrFeedback[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AsrFeedback {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String?       @map("user_id") @db.Uuid
  conversationId      String        @map("conversation_id") @db.Uuid
  messageId           String?       @map("message_id") @db.Uuid
  language            LanguageCode  @default(tw)
  focus               String?
  originalTranscript  String        @map("original_transcript") @db.Text
  correctedTranscript String?       @map("corrected_transcript") @db.Text
  rating              Int?
  notes               String?       @db.Text
  asrModel            String?       @map("asr_model")
  asrRoute            String?       @map("asr_route")
  // Consented audio capture: only set when the user explicitly opted in at
  // correction time. Path is relative to ASR_FEEDBACK_AUDIO_DIR.
  audioConsent        Boolean       @default(false) @map("audio_consent")
  audioPath           String?       @map("audio_path")
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@index([language, createdAt])
  @@map("asr_feedback")
}

model SymptomCheck {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  symptoms       String[] 
  freeText       String?       @map("free_text") @db.Text
  severity       SeverityFlag  @default(LOW)
  advice         String        @db.Text
  escalate       Boolean       @default(false)
  language       LanguageCode  @default(tw)
  disclaimer     String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("symptom_checks")
}

model KnowledgeArticle {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  titleTw     String       @map("title_tw")
  titleEn     String       @map("title_en")
  bodyTw      String       @map("body_tw") @db.Text
  bodyEn      String       @map("body_en") @db.Text
  category    String
  tags        String[]
  source      String?
  sourceUrl   String?      @map("source_url")
  isActive    Boolean      @default(true) @map("is_active")
  /// Cached ABENA (or fallback) passage vector — base64 Float32
  embeddingB64 String?     @map("embedding_b64") @db.Text
  embedModel   String?     @map("embed_model")
  embedEngine  String?     @map("embed_engine")
  embeddedAt   DateTime?   @map("embedded_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@map("knowledge_articles")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  nameTw      String   @map("name_tw")
  nameEn      String   @map("name_en")
  descriptionTw String? @map("description_tw") @db.Text
  descriptionEn String? @map("description_en") @db.Text
  category    String
  priceGhs    Decimal  @map("price_ghs") @db.Decimal(10, 2)
  unit        String   @default("piece")
  stock       Int      @default(0)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  tags        String[]
  /// Cached ABENA (or fallback) passage vector — base64 Float32
  embeddingB64 String? @map("embedding_b64") @db.Text
  embedModel   String? @map("embed_model")
  embedEngine  String? @map("embed_engine")
  embeddedAt   DateTime? @map("embedded_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([nameEn])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(MOCK) @map("payment_method")
  totalGhs      Decimal       @map("total_ghs") @db.Decimal(10, 2)
  phone         String?
  notes         String?       @db.Text
  momoRef       String?       @map("momo_ref")
  paystackRef   String?       @unique @map("paystack_ref")
  authorizationUrl String?    @map("authorization_url") @db.Text
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  nameSnap  String  @map("name_snap")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model ConsentRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String
  granted   Boolean
  version   String   @default("1.0")
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consent_records")
}

model TranscriptSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  language     LanguageCode @default(tw)
  rawText      String?  @map("raw_text") @db.Text
  punctuated   String?  @db.Text
  speakers     Json?
  audioDeleted Boolean  @default(true) @map("audio_deleted")
  retained     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")

  @@index([userId])
  @@map("transcript_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model OfflineQueueItem {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id")
  kind      String   // chat | cart
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  syncedAt  DateTime? @map("synced_at")

  @@index([sessionId, status])
  @@map("offline_queue_items")
}
